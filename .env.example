# Server Configuration
PORT=8084
NODE_ENV=development

# Downstream Services
VEHICLE_SERVICE_URL=http://localhost:8083
VEHICLE_SERVICE_TIMEOUT=5000

CATALOG_SERVICE_URL=http://localhost:8082
CATALOG_SERVICE_TIMEOUT=5000

# CORS
CORS_ORIGIN=http://localhost:4200

# Logging
LOG_LEVEL=info

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs